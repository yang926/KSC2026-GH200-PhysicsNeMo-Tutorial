#
# KISTI native ARM64 build path. Apptainer pulls both digest-pinned NGC
# images directly; Docker, Podman, apt, and fakeroot are not used.

Bootstrap: docker
From: nvcr.io/nvidia/nvhpc:25.5-devel-cuda_multi-ubuntu24.04@sha256:d5b8001ed137d70417454279c46f6dde335337efbbd6742a4b1c103cbf85831b
Stage: nvhpc

Bootstrap: docker
From: nvcr.io/nvidia/physicsnemo/physicsnemo:25.11@sha256:4e7f82e33d886828efd1e4d65236f5e44c96dfbd3d316c58723eff9b9298eda6
Stage: final

%arguments
    BUILD_JOBS=12

# Preserve the complete 25.5 compiler and NVPL installation. Copying from the
# previous stage keeps symlinks in the SDK intact.
%files from nvhpc
    /opt/nvidia/hpc_sdk /opt/nvidia/hpc_sdk

# Deliberate host-file allow-list. In particular, active site.env,
# credentials, notebook outputs, and local datasets cannot enter the SIF
# through a broad directory copy.
%files
    .dockerignore /opt/ksc2026/course-source/.dockerignore
    course-release.json /opt/ksc2026/course-source/course-release.json
