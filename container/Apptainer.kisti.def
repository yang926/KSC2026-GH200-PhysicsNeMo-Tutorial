%post
    set -eu

    test "$(dpkg --print-architecture)" = "arm64"
    build_jobs="{{ BUILD_JOBS }}"
    case "${build_jobs}" in
        ''|*[!0-9]*) echo "BUILD_JOBS must be an integer" >&2; exit 1 ;;
    esac
    if [ "${build_jobs}" -lt 1 ] || [ "${build_jobs}" -gt 12 ]; then
        echo "BUILD_JOBS must be between 1 and 12" >&2
        exit 1
    fi

    # The digest-pinned PhysicsNeMo base already provides the ARM64 build
    # toolchain. Fail before downloading sources if that contract changes.
    for required_command in \
        ar awk cmake curl find g++ gcc grep gzip install make readelf \
        sha256sum sort tar xargs nvcc; do
        command -v "${required_command}" >/dev/null 2>&1 || {
            echo "Required base-image tool is missing: ${required_command}" >&2
            exit 1
        }
    done
    cmake --version | awk '
        NR == 1 {
            split($3, version, ".")
            if (version[1] > 3 || (version[1] == 3 && version[2] >= 20)) exit 0
            exit 1
        }
    '

    # nvbandwidth v0.8 requires Boost.ProgramOptions. Build only that library
    # and link it statically so no Boost runtime package is needed.
    mkdir -p /tmp/boost /tmp/boost-install
    curl --fail --location --retry 3 \
        https://archives.boost.io/release/1.83.0/source/boost_1_83_0.tar.gz \
        --output /tmp/boost_1_83_0.tar.gz
    echo "c0685b68dd44cc46574cce86c4e17c0f611b15e195be9848dfd0769a0a207628  /tmp/boost_1_83_0.tar.gz" \
        | sha256sum --check --strict -
    tar --extract --gzip --file /tmp/boost_1_83_0.tar.gz \
        --directory /tmp/boost --strip-components=1
    (
        cd /tmp/boost
        ./bootstrap.sh \
            --with-toolset=gcc \
            --with-libraries=program_options \
            --prefix=/tmp/boost-install
        ./b2 -j"${build_jobs}" \
            --with-program_options \
            toolset=gcc \
            variant=release \
            link=static \
            runtime-link=shared \
            threading=multi \
            cxxstd=17 \
            cxxflags=-fPIC \
            --layout=system \
            --prefix=/tmp/boost-install \
            install
    )
    test -s /tmp/boost-install/lib/libboost_program_options.a
    install -D -m 0644 /tmp/boost/LICENSE_1_0.txt \
        /opt/ksc2026/licenses/Boost-LICENSE_1_0.txt

    mkdir -p /tmp/openblas /opt/ksc2026/vendor/openblas
    curl --fail --location --retry 3 \
        https://github.com/OpenMathLib/OpenBLAS/releases/download/v0.3.31/OpenBLAS-0.3.31.tar.gz \
        --output /tmp/openblas.tar.gz
    echo "6dd2a63ac9d32643b7cc636eab57bf4e57d0ed1fff926dfbc5d3d97f2d2be3a6  /tmp/openblas.tar.gz" \
        | sha256sum --check --strict -
    tar --extract --gzip --file /tmp/openblas.tar.gz \
        --directory /tmp/openblas --strip-components=1
    make -C /tmp/openblas -j"${build_jobs}" \
        DYNAMIC_ARCH=1 NOFORTRAN=1 USE_OPENMP=0
    make -C /tmp/openblas \
        DYNAMIC_ARCH=1 NOFORTRAN=1 USE_OPENMP=0 \
        PREFIX=/opt/ksc2026/vendor/openblas install
    install -D -m 0644 /tmp/openblas/LICENSE \
        /opt/ksc2026/licenses/OpenBLAS-LICENSE
    rm -rf /tmp/openblas /tmp/openblas.tar.gz

    mkdir -p /tmp/nvbandwidth /opt/ksc2026/bin
    curl --fail --location --retry 3 \
        https://github.com/NVIDIA/nvbandwidth/archive/refs/tags/v0.8.tar.gz \
        --output /tmp/nvbandwidth.tar.gz
    echo "b3622945eb7fce2b4e1aea7d13de04f415f4d998db602893201a904320cf2d39  /tmp/nvbandwidth.tar.gz" \
        | sha256sum --check --strict -
    tar --extract --gzip --file /tmp/nvbandwidth.tar.gz \
        --directory /tmp/nvbandwidth --strip-components=1
    cuda_stub="$(find -L /usr/local/cuda -path '*/stubs/libcuda.so' -print -quit)"
    test -n "${cuda_stub}"
    cuda_stub_dir="$(dirname "${cuda_stub}")"
    test -f "${cuda_stub_dir}/libnvidia-ml.so"
    cmake -S /tmp/nvbandwidth -B /tmp/nvbandwidth/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CUDA_ARCHITECTURES=90 \
        -DMULTINODE=OFF \
        -DBOOST_ROOT=/tmp/boost-install \
        -DBoost_ROOT=/tmp/boost-install \
        -DBOOST_LIBRARYDIR=/tmp/boost-install/lib \
        -DBoost_NO_SYSTEM_PATHS=ON \
        -DBoost_NO_BOOST_CMAKE=ON \
        -DBoost_USE_STATIC_LIBS=ON \
        -DBoost_USE_STATIC_RUNTIME=OFF \
        -DCMAKE_PREFIX_PATH=/tmp/boost-install \
        -DCMAKE_EXE_LINKER_FLAGS="-L${cuda_stub_dir}"
    cmake --build /tmp/nvbandwidth/build --parallel "${build_jobs}"
    test -f /tmp/nvbandwidth/build/CMakeFiles/nvbandwidth.dir/link.txt
    grep --fixed-strings --quiet \
        /tmp/boost-install/lib/libboost_program_options.a \
        /tmp/nvbandwidth/build/CMakeFiles/nvbandwidth.dir/link.txt
    install -D -m 0755 /tmp/nvbandwidth/build/nvbandwidth \
        /opt/ksc2026/bin/nvbandwidth
    install -D -m 0644 /tmp/nvbandwidth/LICENSE \
        /opt/ksc2026/licenses/nvbandwidth-LICENSE
    install -D -m 0644 /tmp/nvbandwidth/Licenses.txt \
        /opt/ksc2026/licenses/nvbandwidth-Licenses.txt
    if readelf -d /opt/ksc2026/bin/nvbandwidth \
        | grep -Eiq 'NEEDED.*libboost_program_options|RPATH.*\/tmp|RUNPATH.*\/tmp'; then
        echo "nvbandwidth has an unexpected dynamic Boost dependency or build-path RPATH" >&2
        exit 1
    fi
    rm -rf \
        /tmp/boost /tmp/boost-install /tmp/boost_1_83_0.tar.gz \
        /tmp/nvbandwidth /tmp/nvbandwidth.tar.gz

    chmod 0755 \
        /opt/ksc2026/container/entrypoint.sh \
        /opt/ksc2026/container/smoke_test.sh \
        /opt/ksc2026/course-source/container/build_image.sh \
        /opt/ksc2026/course-source/container/build_sif.sh \
        /opt/ksc2026/course-source/container/build_kisti_sif.sh \
        /opt/ksc2026/course-source/container/entrypoint.sh \
        /opt/ksc2026/course-source/container/smoke_test.sh \
        /opt/ksc2026/course-source/operations/participant/ksc2026 \
        /opt/ksc2026/course-source/operations/participant/start-jupyter \
        /opt/ksc2026/course-source/operations/participant/session-controller.py \
        /opt/ksc2026/course-source/operations/participant/jupyter-job.sh \
        /opt/ksc2026/course-source/operations/admin/publish-course.sh \
        /opt/ksc2026/course-source/operations/admin/participant/install-participants.sh

    test -x /opt/nvidia/hpc_sdk/Linux_aarch64/25.5/compilers/bin/nvc
    test -d /opt/nvidia/hpc_sdk/Linux_aarch64/25.5/math_libs/nvpl/include
    test -d /opt/nvidia/hpc_sdk/Linux_aarch64/25.5/math_libs/nvpl/lib
    command -v gcc >/dev/null
    command -v nvcc >/dev/null
    command -v nsys >/dev/null
    command -v jupyter-lab >/dev/null
    command -v /opt/ksc2026/bin/nvbandwidth >/dev/null
    /opt/nvidia/physicsnemo_env.sh python3 -c 'import physicsnemo, physicsnemo.sym, torch'
    find /opt/ksc2026/course-source -type f -print0 \
        | sort -z \
        | xargs -0 sha256sum \
        > /opt/ksc2026/course-manifest.sha256

%environment
    export KSC_SOURCE_DIR=/opt/ksc2026/course-source
    export KSC_IMAGE_MANIFEST=/etc/ksc2026-image.json
    export NVHPC_ROOT=/opt/nvidia/hpc_sdk/Linux_aarch64/25.5
    export NVPL_ROOT=/opt/nvidia/hpc_sdk/Linux_aarch64/25.5/math_libs/nvpl
    export OPENBLAS_ROOT=/opt/ksc2026/vendor/openblas
    export PATH=/opt/ksc2026/bin:/usr/local/cuda/bin:/opt/nvidia/hpc_sdk/Linux_aarch64/25.5/compilers/bin:${PATH}
    export CPATH=/opt/nvidia/hpc_sdk/Linux_aarch64/25.5/math_libs/nvpl/include:${CPATH:-}
    export LIBRARY_PATH=/opt/nvidia/hpc_sdk/Linux_aarch64/25.5/math_libs/nvpl/lib:/opt/nvidia/hpc_sdk/Linux_aarch64/25.5/compilers/lib:${LIBRARY_PATH:-}
    export LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-}:/opt/nvidia/hpc_sdk/Linux_aarch64/25.5/math_libs/nvpl/lib:/opt/nvidia/hpc_sdk/Linux_aarch64/25.5/compilers/lib:/opt/ksc2026/vendor/openblas/lib
    export PIP_NO_INDEX=1
    export PIP_DISABLE_PIP_VERSION_CHECK=1
    export HF_HUB_OFFLINE=1
    export TRANSFORMERS_OFFLINE=1
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1

%labels
    org.opencontainers.image.title KSC 2026 GH200 + PhysicsNeMo course
    org.opencontainers.image.description Offline ARM64 course image built directly with Apptainer on KISTI
    org.opencontainers.image.version 25.11-arm64
    org.opencontainers.image.source https://github.com/yang926/KSC2026-GH200-PhysicsNeMo-Tutorial
    kr.repro.ksc2026.runtime-compatibility ksc2026-gh200-physicsnemo-25.11-arm64-v1
    kr.repro.ksc2026.physicsnemo.version 25.11
    kr.repro.ksc2026.nvhpc.version 25.5
    kr.repro.ksc2026.nvpl.version 25.5
    kr.repro.ksc2026.boost-program-options.version 1.83.0-static
    kr.repro.ksc2026.openblas.version 0.3.31
    kr.repro.ksc2026.nvbandwidth.version 0.8
    kr.repro.ksc2026.runtime-network-required false

%runscript
    exec /opt/nvidia/physicsnemo_env.sh /opt/ksc2026/container/entrypoint.sh "$@"

%test
    /opt/nvidia/physicsnemo_env.sh /opt/ksc2026/container/smoke_test.sh --static
