# 운영자가 공용 런처에 한 번 설치하는 읽기 전용 사이트 계약입니다.
# 셸로 source하지 않고 KEY=VALUE 데이터로만 읽습니다.
KSC_SHARED_ROOT=/scratch/hackathon/ksc2026
# 공개 저장소에는 실제 IP나 호스트명을 넣지 않습니다. 행사 운영 설정에서 바꿉니다.
KSC_LOGIN_HOST=REPLACE_WITH_EVENT_LOGIN_HOST
KSC_PARTITION=gpu
KSC_JOB_COMMENT=jupyter
KSC_GRES_NAME=nvidia_gh200_120gb
KSC_TIME_LIMIT=1-00:00:00
KSC_READY_TIMEOUT=900
KSC_APPTAINER=/apps/common/apptainer/1.4.5/aarch64/bin/apptainer
KSC_IMAGE=/scratch/hackathon/ksc2026/images/ksc2026-gh200-physicsnemo_25.11-arm64.sif
KSC_IMAGE_SHA256=ee43b2c0735b26a7168e53c7e598dd5dc527b1e23284682f790430656d8bdacf
KSC_SIF_SHA256=ee43b2c0735b26a7168e53c7e598dd5dc527b1e23284682f790430656d8bdacf
KSC_COURSE_RELEASE_ROOT=/scratch/hackathon/ksc2026/course-releases
# 첫 게시 때 publish-course.sh가 새 immutable release의 정확한 경로로 갱신합니다.
KSC_COURSE_RELEASE=/scratch/hackathon/ksc2026/course-releases/REPLACE_WITH_VERIFIED_COMMIT
KSC_COURSE_REPOSITORY=https://github.com/yang926/KSC2026-GH200-PhysicsNeMo-Tutorial.git
KSC_COURSE_REF=main
KSC_COURSE_SOURCE=/scratch/hackathon/ksc2026/course-current
KSC_RUNTIME_COMPATIBILITY=ksc2026-gh200-physicsnemo-25.11-arm64-v1
KSC_JOB_SCRIPT=/scratch/hackathon/ksc2026/slurm/jupyter-job.sh
KSC_STATE_ROOT=/scratch/{user}/ksc2026/session
KSC_WORKSPACE_ROOT=/scratch/{user}/ksc2026/workspaces
KSC_LOG_ROOT=/scratch/{user}/ksc2026/logs
# KISTI가 승인한 1/4-node CPU·메모리 값이 확정되면 채웁니다.
KSC_CPUS_PER_TASK=
KSC_MEMORY=
