#!/usr/bin/env bash
# Shared participant command installed at /scratch/hackathon/ksc2026/bin/ksc2026.

set -Eeuo pipefail

die() {
    printf 'KSC2026 오류: %s\n' "$1" >&2
    exit 1
}

for required_command in flock stat; do
    command -v "$required_command" >/dev/null 2>&1 || \
        die "필수 명령을 찾을 수 없습니다: $required_command"
done

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
central_root="${script_dir%/bin}"
[[ "$central_root" != "$script_dir" ]] || die "공유 command 경로가 올바르지 않습니다: $script_dir"
deployment_lock="$central_root/admin/deployment.lock"
[[ -f "$deployment_lock" && ! -L "$deployment_lock" ]] || \
    die "중앙 배포 lock이 안전하지 않습니다: $deployment_lock"
central_uid="$(stat -c '%u' "$central_root")" || die "공유 root owner를 확인할 수 없습니다."
[[ "$central_uid" =~ ^[0-9]+$ && \
   "$(stat -c '%u:%a:%h' "$deployment_lock")" == "$central_uid:644:1" ]] || \
    die "중앙 배포 lock의 owner, mode 또는 link 수가 올바르지 않습니다: $deployment_lock"

# FD 9 is deliberately opened without close-on-exec. The shared flock remains
# attached to this open file description through env, bash, and Python execs.
exec 9<"$deployment_lock" || die "중앙 배포 lock을 열 수 없습니다: $deployment_lock"
flock -s 9 || die "중앙 배포 lock을 얻을 수 없습니다: $deployment_lock"
lock_fd_identity="$(stat -Lc '%d:%i' /dev/fd/9)" || \
    die "잠근 중앙 배포 lock FD를 확인할 수 없습니다."
[[ "$(stat -c '%d:%i' "$deployment_lock")" == "$lock_fd_identity" ]] || \
    die "잠근 중앙 배포 lock과 현재 경로가 다릅니다: $deployment_lock"
[[ -f "$deployment_lock" && ! -L "$deployment_lock" && \
   "$(stat -c '%u:%a:%h' "$deployment_lock")" == "$central_uid:644:1" ]] || \
    die "잠금 중 중앙 배포 lock이 바뀌었습니다: $deployment_lock"

exec /usr/bin/env -u BASH_ENV -u ENV /bin/bash --noprofile --norc \
    "$script_dir/start-jupyter" "$@"
